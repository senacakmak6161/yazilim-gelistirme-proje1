{
  "name": "ders-panosu-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Etkileşimli Ders Deneyimi Panosu için Playwright kabul testleri ve izlenebilirlik raporu.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm run test:list",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "traceability": "node scripts/traceability.mjs",
    "traceability:strict": "node scripts/traceability.mjs --strict"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0"
  }
}
